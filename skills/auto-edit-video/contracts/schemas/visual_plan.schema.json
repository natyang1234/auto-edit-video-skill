{
  "$id": "auto-edit-video/contracts/visual_plan",
  "title": "visual_plan",
  "x_schema_version": 1,
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "highlight_plan_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^visual-beat-[0-9a-f]{8,}$"
          },
          "highlight_id": {
            "type": "string",
            "pattern": "^highlight-[0-9a-f]{8,}$"
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "beat": {
            "type": "string",
            "enum": [
            "keep_aroll",
            "a_roll_breathing",
            "broll",
              "image",
              "svg",
              "title",
              "stat",
              "chart",
              "dynamic_list",
              "animation",
              "quote",
              "question",
              "comparison",
              "term",
              "typed_prompt",
              "grid_progress",
              "asset_mosaic"
            ]
          },
          "structured_layer_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "selected_asset": {
            "type": [
              "string",
              "null"
            ]
          },
          "conceptual_only": {
            "type": "boolean"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^evidence-[0-9a-f]{8,}$"
            }
          },
          "review_status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected"
            ]
          },
          "eligibility": {
            "enum": ["eligible", "ineligible"]
          },
          "eligibility_reason": {
            "type": ["string", "null"],
            "enum": [
              null,
              "missing_transcript_evidence",
              "unsupported_payload",
              "missing_licensed_asset",
              "density_budget",
              "layout_collision"
            ]
          },
          "family": {
            "enum": [
              "title_reveal",
              "staggered_list",
              "analytics_dashboard",
              "count_stat",
              "asset_mosaic",
              "grid_progress",
              "typed_prompt"
            ]
          },
          "role": {
            "enum": [
              "opening_title",
              "section_title",
              "list_explanation",
              "data_explanation",
              "metric_emphasis",
              "asset_showcase",
              "workflow_progress",
              "prompt_command"
            ]
          },
          "importance": {
            "enum": ["low", "medium", "high"]
          },
          "major_graphic": {
            "type": "boolean"
          },
          "micro_silent": {
            "type": "boolean"
          },
          "stage": {
            "enum": ["full_screen_graphic", "split_graphic_presenter"]
          },
          "trigger_role": {
            "type": ["string", "null"],
            "enum": [
              null,
              "title_enter",
              "scene_transition",
              "row_reveal",
              "count_complete",
              "chart_complete",
              "grid_complete",
              "typing"
            ]
          }
        },
        "required": [
          "beat",
          "conceptual_only",
          "end",
          "evidence_ids",
          "highlight_id",
          "id",
          "review_status",
          "selected_asset",
          "start",
          "structured_layer_id"
        ],
        "additionalProperties": false
      }
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "highlight_plan_revision",
    "items",
    "revision",
    "schema_version"
  ],
  "additionalProperties": false
}
