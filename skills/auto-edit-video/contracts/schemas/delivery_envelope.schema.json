{
  "$id": "delivery_envelope",
  "title": "Finalized delivery envelope (direct, server-single, batch and variant routes)",
  "x_schema_version": 1,
  "type": "object",
  "required": [
    "schema_version",
    "route",
    "render_id",
    "state",
    "quality",
    "profile",
    "timeline",
    "artifacts",
    "renderer_identity",
    "prepared_envelope_hash"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "route": {"enum": ["direct", "single", "batch", "variant"]},
    "render_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,120}$"
    },
    "state": {"enum": ["prepared", "finalized"]},
    "quality": {"const": "final"},
    "profile": {
      "type": "object",
      "required": ["id", "resolved_profile_hash"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,120}$"
        },
        "resolved_profile_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "timeline": {
      "type": "object",
      "required": ["editor_state_revision", "cut_map_sha256"],
      "properties": {
        "editor_state_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "cut_map_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "batch": {
      "description": "Aggregate binding written by the batch route only: member order, per-member published output bytes and the exact bytes stored in the archive.",
      "type": ["object", "null"],
      "required": ["schema_version", "batch_id", "members"],
      "properties": {
        "schema_version": {"const": 1},
        "batch_id": {"type": "string", "pattern": "^batch_[0-9a-f]{32}$"},
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "index",
              "clip_id",
              "render_id",
              "envelope_sha256",
              "output",
              "archive_name",
              "archive_sha256"
            ],
            "properties": {
              "index": {"type": "integer", "minimum": 1},
              "clip_id": {"type": "string", "minLength": 1, "maxLength": 200},
              "render_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,120}$"},
              "envelope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "output": {
                "type": "object",
                "required": ["path", "sha256", "bytes"],
                "properties": {
                  "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]{1,500}$"},
                  "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "bytes": {"type": "integer", "minimum": 0}
                },
                "additionalProperties": false
              },
              "archive_name": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,200}$"},
              "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "visual_authority": {
      "type": ["object", "null"],
      "required": [
        "schema_version",
        "source",
        "visual_plan_revision",
        "visual_plan_sha256",
        "structured_layers_sha256",
        "artifact_index_sha256",
        "authority_hash"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "source": {"const": "frozen_visual_authority"},
        "visual_plan_revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "visual_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "structured_layers_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "artifact_index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "authority_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "required": [
        "output",
        "qa_report",
        "contact_sheet",
        "visual_evidence",
        "motion_evidence",
        "caption_v2",
        "audio_event_plan",
        "audio_catalog",
        "sfx_stem"
      ],
      "properties": {
        "output": {
          "type": "object",
          "required": ["path", "sha256", "bytes"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "bytes": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "qa_report": {
          "type": "object",
          "required": ["path", "sha256", "bytes"],
          "properties": {
            "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]{1,500}$"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "bytes": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "contact_sheet": {
          "type": ["object", "null"],
          "required": ["path", "sha256", "bytes"],
          "properties": {
            "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]{1,500}$"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "bytes": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "visual_evidence": {
          "type": ["object", "null"],
          "required": ["path", "sha256", "bytes"],
          "properties": {
            "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]{1,500}$"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "bytes": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "motion_evidence": {
          "type": ["object", "null"],
          "required": ["path", "sha256", "bytes"],
          "properties": {
            "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]{1,500}$"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "bytes": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "caption_v2": {
          "type": ["object", "null"],
          "required": ["path", "sha256", "bytes"],
          "properties": {
            "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]{1,500}$"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "bytes": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "audio_event_plan": {
          "type": ["object", "null"],
          "required": ["path", "sha256", "bytes"],
          "properties": {
            "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]{1,500}$"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "bytes": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "audio_catalog": {
          "type": ["object", "null"],
          "required": ["path", "sha256", "bytes"],
          "properties": {
            "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]{1,500}$"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "bytes": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "sfx_stem": {
          "type": ["object", "null"],
          "required": ["path", "sha256", "bytes"],
          "properties": {
            "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]{1,500}$"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "bytes": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "renderer_identity": {
      "type": "object",
      "required": [
        "name",
        "contract_version",
        "script_sha256",
        "ffmpeg_executable_sha256"
      ],
      "properties": {
        "name": {"const": "render_editor_timeline"},
        "contract_version": {"const": 1},
        "script_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ffmpeg_executable_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "prepared_envelope_hash": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
