  }
 },
 "required": [
  "engine",
  "evidence_map_revision",
  "frozen",
  "generated_at",
  "idea_candidates",
  "retention_risks",
  "revision",
  "schema_version",
  "source_sha256",
  "transcript_revision",
  "truth_map"
