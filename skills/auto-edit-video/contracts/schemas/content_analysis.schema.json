  "revision": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "evidence_map_revision": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "transcript_revision": {
   "type": "string",
