  "retention_risks": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "start": {
      "type": "number",
      "minimum": 0
     },
     "end": {
      "type": "number",
      "minimum": 0
     },
     "kind": {
      "type": "string",
      "enum": [
       "slow_open",
       "repetition",
       "tangent",
       "late_payoff",
       "abstract",
       "static_visual",
       "unsupported_claim"
      ]
     },
     "note": {
      "type": "string"
