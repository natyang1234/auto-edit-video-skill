{
  "$id": "sfx_catalog",
  "title": "Phase 1 deterministic local SFX starter catalog",
  "x_schema_version": 1,
  "type": "object",
  "required": [
    "schema_version",
    "sample_rate",
    "channels",
    "sample_width_bytes",
    "assets"
  ],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1, 2]},
    "sample_rate": {"const": 48000},
    "channels": {"const": 2},
    "sample_width_bytes": {"const": 3},
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "pack",
          "role",
          "duration_samples",
          "transient_anchor_sample",
          "noise_floor_dbfs",
          "rms_dbfs",
          "peak_dbfs",
          "wav_sha256",
          "decoded_pcm_sha256",
          "provenance",
          "review_state"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-v[0-9]+$"
          },
          "pack": {
            "enum": ["phase0d-local-procedural", "phase1-local-procedural", "external-licensed"]
          },
          "role": {
            "enum": [
              "title_enter",
              "row_reveal",
              "transition",
              "grid_fill",
              "count_tick",
              "typing",
              "complete",
              "content_hint"
            ]
          },
          "category": {
            "enum": ["cash_coin", "click_pop", "whoosh", "impact_hit", "success_ding", "error_glitch"]
          },
          "generator": {
            "type": "object",
            "required": ["name", "version", "recipe"],
            "properties": {
              "name": {
                "enum": [
                  "soft_ui_tick",
                  "short_pop",
                  "short_whoosh",
                  "soft_impact",
                  "short_riser",
                  "typing_tick",
                  "completion_chime",
                  "coin_blip",
                  "glitch_buzz"
                ]
              },
              "version": {"const": 1},
              "recipe": {
                "enum": [
                  "two_sine_exponential_decay",
                  "sine_pop_exponential_decay",
                  "swept_sine_fade",
                  "low_tone_exponential_decay",
                  "swept_sine_rise",
                  "short_sine_exponential_decay",
                  "two_note_exponential_decay",
                  "double_sine_ping",
                  "square_burst_exponential_decay"
                ]
              }
            },
            "additionalProperties": false
          },
          "license": {
            "type": "object",
            "required": ["name", "source_url", "commercial_ok", "attribution_required"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "source_url": {"type": "string", "minLength": 1},
              "commercial_ok": {"type": "boolean"},
              "attribution_required": {"type": "boolean"}
            },
            "additionalProperties": false
          },
          "library_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "duration_samples": {
            "type": "integer",
            "minimum": 1920,
            "maximum": 72000
          },
          "transient_anchor_sample": {
            "type": "integer",
            "minimum": 0
          },
          "noise_floor_dbfs": {
            "type": "number",
            "minimum": -120,
            "maximum": 0
          },
          "rms_dbfs": {
            "type": "number",
            "exclusiveMinimum": -45,
            "maximum": 0
          },
          "peak_dbfs": {
            "type": "number",
            "minimum": -12,
            "maximum": -1
          },
          "wav_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "decoded_pcm_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "provenance": {"type": "string", "minLength": 1},
          "review_state": {"enum": ["approved_generated", "approved_licensed"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
