      "type": "string"
     },
     "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
     }
    },
    "required": [
     "start",
     "end",
     "text",
     "confidence"
    ],
    "additionalProperties": false
   }
  },
  "revision": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
