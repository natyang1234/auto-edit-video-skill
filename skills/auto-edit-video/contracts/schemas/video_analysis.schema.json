   "const": 1
  },
  "source_sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "engines": {
   "type": "object",
   "properties": {
    "ffprobe": {
     "type": "object",
     "properties": {
      "name": {
       "type": "string",
       "minLength": 1
      },
      "version": {
       "type": "string"
      },
      "status": {
       "type": "string",
       "enum": [
        "present",
        "not_configured"
       ]
      }
     },
     "required": [
      "name",
      "status",
      "version"
     ],
     "additionalProperties": false
    },
    "asr": {
     "type": "object",
     "properties": {
      "name": {
       "type": "string",
       "minLength": 1
      },
      "version": {
       "type": "string"
      },
      "status": {
       "type": "string",
       "enum": [
        "present",
        "not_configured"
       ]
      }
     },
     "required": [
      "name",
      "status",
      "version"
     ],
     "additionalProperties": false
    },
    "ocr": {
     "type": "object",
     "properties": {
      "name": {
       "type": "string",
       "minLength": 1
      },
      "version": {
       "type": "string"
      },
      "status": {
       "type": "string",
       "enum": [
        "present",
        "not_configured"
       ]
      }
     },
     "required": [
      "name",
      "status",
      "version"
     ],
     "additionalProperties": false
    },
    "shot_detector": {
     "type": "object",
     "properties": {
      "name": {
       "type": "string",
       "minLength": 1
      },
      "version": {
       "type": "string"
      },
      "status": {
       "type": "string",
       "enum": [
        "present",
        "not_configured"
       ]
      }
     },
     "required": [
      "name",
      "status",
      "version"
     ],
     "additionalProperties": false
    }
   },
   "required": [
    "asr",
    "ffprobe",
    "ocr",
    "shot_detector"
   ],
   "additionalProperties": false
  },
  "duration_s": {
   "type": "number",
   "minimum": 0
  },
  "width": {
   "type": "integer",
   "minimum": 1
  },
  "height": {
   "type": "integer",
   "minimum": 1
  },
  "fps": {
   "type": "number",
   "minimum": 1
  },
  "loudness_lufs": {
   "type": "number"
  },
  "silences": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "start": {
      "type": "number",
      "minimum": 0
