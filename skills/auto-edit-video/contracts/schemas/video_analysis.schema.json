 "required": [
  "duration_s",
  "engines",
  "fps",
  "height",
  "loudness_lufs",
  "ocr_spans",
  "revision",
  "schema_version",
  "shots",
  "silences",
  "source_sha256",
  "width"
 ],
 "additionalProperties": false
}
