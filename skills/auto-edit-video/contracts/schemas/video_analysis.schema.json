     "end": {
      "type": "number",
      "minimum": 0
     }
    },
    "required": [
     "start",
     "end"
    ],
    "additionalProperties": false
   }
  },
  "shots": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "start": {
      "type": "number",
      "minimum": 0
