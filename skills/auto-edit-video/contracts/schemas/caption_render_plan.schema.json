{
  "$id": "auto-edit-video/contracts/caption_render_plan",
  "title": "caption_render_plan",
  "x_schema_version": 1,
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "caption_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "grapheme_contract": {
      "const": "grapheme_cluster_v1"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "caption_item_id": {
            "type": "string",
            "minLength": 1
          },
          "clusters": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "glyph_runs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "font_asset_id": {
                  "type": "string",
                  "minLength": 1
                },
                "cluster_start": {
                  "type": "integer",
                  "minimum": 0
                },
                "cluster_end": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "cluster_end",
                "cluster_start",
                "font_asset_id"
              ],
              "additionalProperties": false
            }
          },
          "artifact": {
            "type": "object",
            "properties": {
              "rgba_path": {
                "type": "string",
                "minLength": 1
              },
              "artifact_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              },
              "padding": {
                "type": "integer",
                "minimum": 0,
                "description": "Transparent margin on each side, for stroke and emphasis growth. The ink is this much narrower than width, which is what a check about covering or being covered has to measure."
              },
              "spoken_height": {
                "type": "integer",
                "minimum": 1,
                "description": "Height of the spoken line's part of the raster; the remainder below it is the translation."
              }
            },
            "required": [
              "artifact_hash",
              "height",
              "padding",
              "rgba_path",
              "spoken_height",
              "width"
            ],
            "additionalProperties": false
          },
          "style_sources": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "typography": {
            "type": "object",
            "description": "SPEC Phase 3 v1 §1 type tokens actually used to draw this item.",
            "properties": {
              "primary_font_size": {
                "type": "number",
                "minimum": 0
              },
              "primary_line_count": {
                "type": "integer",
                "minimum": 1
              },
              "secondary_font_size": {
                "type": ["number", "null"],
                "minimum": 0,
                "description": "Null when the caption carries no translation: there is no secondary tier to report a size for."
              },
              "secondary_line_count": {
                "type": "integer",
                "minimum": 0
              },
              "needs_shortening": {
                "type": "boolean",
                "description": "True when the secondary floor overrode the 0.62 ratio; sub-slice 3 resolves this by shortening the translation."
              },
              "secondary_ratio": {
                "type": ["number", "null"],
                "minimum": 0,
                "description": "Secondary size divided by primary size as drawn (nominally 0.62); null without a translation. Above 0.62 the 32px floor held the translation up because the spoken line shrank, which is what needs_shortening reports."
              },
              "measured": {
                "type": "object",
                "description": "SPEC Phase 3 v1 §2 layout read back out of the drawn frame, not derived from the tokens above.",
                "properties": {
                  "primary_line_pitch": {
                    "type": ["number", "null"],
                    "minimum": 0,
                    "description": "Baseline-to-baseline distance inside the spoken block; null for a single-line block."
                  },
                  "secondary_line_pitch": {
                    "type": ["number", "null"],
                    "minimum": 0,
                    "description": "Baseline-to-baseline distance inside the translation block; null below two translation lines."
                  },
                  "block_gap": {
                    "type": ["number", "null"],
                    "description": "Extra space between the spoken and translation blocks; null when there is no translation."
                  },
                  "translation_height": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Raster height the translation added, gap included; the renderer's y-shift reads this via artifact.spoken_height."
                  }
                },
                "required": [
                  "block_gap",
                  "primary_line_pitch",
                  "secondary_line_pitch",
                  "translation_height"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "measured",
              "needs_shortening",
              "primary_font_size",
              "primary_line_count",
              "secondary_font_size",
              "secondary_line_count",
              "secondary_ratio"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "artifact",
          "caption_item_id",
          "clusters",
          "glyph_runs",
          "typography"
        ],
        "additionalProperties": false
      }
    },
    "receipt": {
      "type": "object",
      "properties": {
        "shaping_engine": {
          "type": "string",
          "minLength": 1
        },
        "shaping_engine_version": {
          "type": "string",
          "minLength": 1
        },
        "fonts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string"
              }
            }
          }
        },
        "disallowed_fallbacks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "disallowed_fallbacks",
        "fonts",
        "shaping_engine",
        "shaping_engine_version"
      ],
      "additionalProperties": false
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "caption_revision",
    "grapheme_contract",
    "items",
    "receipt",
    "revision",
    "schema_version"
  ],
  "additionalProperties": false
}
